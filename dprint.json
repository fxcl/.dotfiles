{
    "lineWidth": 120,
    "indentWidth": 4,
    "newLineKind": "auto",
    "useTabs": false,
    "typescript": {
        "semiColons": "asi",
        "quoteStyle": "preferSingle",
        "jsx.quoteStyle": "preferSingle",
        "quoteProps": "asNeeded",
        "arrowFunction.useParentheses": "force",
        "binaryExpression.linePerExpression": true,
        "useBraces": "always",
        "bracePosition": "sameLine",
        "singleBodyPosition": "nextLine",
        "preferHanging": true,
        "memberExpression.linePerExpression": true,
        "typeLiteral.separatorKind": "comma",
        "constructorType.spaceAfterNewKeyword": true,
        "constructSignature.spaceAfterNewKeyword": true,
        "jsxExpressionContainer.spaceSurroundingExpression": true,
        "taggedTemplate.spaceBeforeLiteral": false,
        "enumDeclaration.memberSpacing": "newLine",
        "importDeclaration.forceSingleLine": true,
        "module.sortImportDeclarations": "maintain",
        "module.sortExportDeclarations": "maintain"
    },
    "css": {
        "useTabs": true,
        "indentWidth": 4,
        "lineWidth": 80
    },
    "json": {
        "associations": [
            "*.json",
            "*.jsonc",
            "*.json5",
            "*.nswag",
            "*.dmw"
        ]
    },
    "yaml": {
        "printWidth": 100,
        "ignoreCommentDirective": "dprint-ignore"
    },
    "malva": {
        "printWidth": 100,
        "hexCase": "upper",
        "hexColorLength": "long",
        "operatorLinebreak": "before",
        "trailingComma": true,
        "formatComments": true,
        "linebreakInPseudoParens": true,
        "declarationOrder": "concentric",
        "keyframeSelectorNotation": "keyword",
        "selectorOverrideCommentDirective": "dprint-selector-override",
        "ignoreCommentDirective": "dprint-ignore"
    },
    "markup": {
        "printWidth": 120,
        "formatComments": true,
        "scriptIndent": true,
        "styleIndent": true,
        "component.selfClosing": true,
        "svg.selfClosing": true,
        "mathml.selfClosing": true,
        "html.normal.selfClosing": false,
        "html.void.selfClosing": true,
        "strictSvelteAttr": true,
        "ignoreCommentDirective": "dprint-ignore"
    },
    "includes": [
        "**/*.{ts,tsx,js,jsx,cjs,mjs,json,md,toml,dockerfile,css}",
        ".eslintrc.js"
    ],
    "excludes": [
        "**/node_modules",
        "**/*-lock.json",
        "pnpm-lock.yaml",
        "**/.ipynb_checkpoints",
        "**/.mypy_cache",
        "**/.nox",
        "**/.nox_*",
        "**/.venv/**",
        "**/.pytest_cache",
        "**/__pycache__",
        "**/mypy_reports",
        "**/node_modules",
        "**/tests",
        "**/target",
        "**/dist",
        "**/.yalc",
        "**/coverage",
        "**/build",
        "**/cache",
        "**/dist",
        "**/tmp",
        "**/obj",
        "**/.storybook/documentation.json",
        "**/storybook-static",
        "**/*/android/app",
        "**/*/ios/App"
    ],
    "exec": {
        "commands": [{
            "command": "rustfmt",
            "exts": ["rs"]
        }]
    },
    "plugins": [
        "https://plugins.dprint.dev/typescript-0.93.3.wasm",
        "https://plugins.dprint.dev/json-0.19.4.wasm",
        "https://plugins.dprint.dev/markdown-0.17.8.wasm",
        "https://plugins.dprint.dev/toml-0.6.3.wasm",
        "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.5.0.wasm",
        "https://plugins.dprint.dev/dockerfile-0.3.2.wasm",
        "https://plugins.dprint.dev/g-plane/malva-v0.11.1.wasm",
        "https://plugins.dprint.dev/g-plane/markup_fmt-v0.18.0.wasm"
    ]
}
