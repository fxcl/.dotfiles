#!/usr/bin/env sh

# Proto environment setup
export PROTO_HOME="$HOME/.proto"
export PATH="$PROTO_HOME/shims:$PROTO_HOME/bin:$PATH"

# Tool-specific shims
export PNPM_HOME="$PROTO_HOME/cache/pnpm"
export YARN_HOME="$PROTO_HOME/cache/yarn"
export MOON_HOME="$PROTO_HOME/cache/moon"
export PATH="$PNPM_HOME:$YARN_HOME:$MOON_HOME:$PATH"

# Node.js setup
NODE_VERSION=$(grep -E '^node = "[0-9.]+"' ~/.proto/.prototools | awk -F'"' '{print $2}')
if [ -n "$NODE_VERSION" ]; then
  export NODE_HOME="$PROTO_HOME/tools/node/$NODE_VERSION"
  # export PATH="$NODE_HOME:$PATH"
  if [ -d "$NODE_HOME/bin" ]; then
    export PATH="$NODE_HOME/bin:$PATH"
  fi
fi

# Go setup
if command -v go >/dev/null 2>&1; then
 GO_VERSION=$(grep -E '^go = "[0-9.]+"' ~/.proto/.prototools | awk -F'"' '{print $2}')
  [ ! -d "$HOME/go" ] && mkdir -p "$HOME/go"
  if [ -n "$GO_VERSION" ]; then
      export GOROOT="$PROTO_HOME/tools/go/$GO_VERSION"
  fi
  export GO111MODULE=on
  export GOPROXY="https://goproxy.cn,direct"
  export GOOS=darwin
  export GOARCH=amd64
  export GOPATH="$HOME/go"
  export PATH="$GOPATH/bin:$GOROOT/bin:$PATH"
  export PATH="$PATH:$(go env GOPATH)/bin"
fi

# Proto aliases
alias plist="proto list --aliases"
alias psearch="proto list-remote --aliases"
alias pupgrade="proto upgrade"

# Proto custom commands
pinstall() {
  local version=${2:-latest}
  [[ $# -eq 1 ]] && echo -e "\033[0;33mWarning: No version provided. Using 'latest' as version tag.\033[0m\n"
  proto install --pin  "$1" "$version"
}

prm() {
  local version=${2:-latest}
  [[ $# -eq 1 ]] && echo -e "\033[0;33mWarning: No version provided. Using 'latest' as version tag.\033[0m\n"
  proto uninstall "$1" "$version"
}

poutdated() {
  if [[ -f .prototools ]]; then
    proto outdated
  elif [[ $# -eq 0 ]]; then
    echo -e "\033[0;33mWarning: No argument provided. Checking global tools...\033[0m\n"
    (cd "$PROTO_HOME" && proto outdated)
  elif [[ -d $1 ]]; then
    (cd "$1" && proto outdated)
  else
    echo -e "\033[0;31mInvalid argument: $1\033[0m"
  fi
}

ptools() {
  if [[ -f .prototools ]]; then
    proto status
  elif [[ $# -eq 0 ]]; then
    echo -e "\033[0;33mWarning: No argument provided. Checking global tools...\033[0m\n"
    (cd "$PROTO_HOME" && proto status)
  elif [[ -d $1 ]]; then
    (cd "$1" && proto status)
  else
    echo -e "\033[0;31mInvalid argument: $1\033[0m"
  fi
}

phelp() {
  echo "Custom commands for Proto."
  echo
  echo "Usage: <P-COMMAND> [OPTIONS]"
  echo
  echo "Commands:"
  echo "  pinstall <TOOL> <[VERSION]>  - Install <TOOL> at <[VERSION]>. If <[VERSION]> is not provided, it will be set to 'latest'."
  echo "  prm <TOOL> <[VERSION]>       - Uninstall <TOOL> at <[VERSION]>. If <[VERSION]> is not provided, it will be set to 'latest'."
  echo "  plist <TOOL>                 - List all installed versions of <TOOL>."
  echo "  psearch <TOOL>               - Search for available versions of <TOOL>."
  echo "  pupgrade                     - Upgrade proto itself."
  echo "  poutdated <[DIRECTORY]>      - Show outdated tools in <directory>. If <[DIRECTORY]> is not provided, it will be set to '$PROTO_HOME'."
  echo "  ptools <[DIRECTORY]>         - List all installed tools in <directory>. If <[DIRECTORY]> is not provided, it will be set to '$PROTO_HOME'."
}
