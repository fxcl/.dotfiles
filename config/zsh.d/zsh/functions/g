# vim:ft=zsh:

# https://github.com/pengwynn/dotfiles/blob/master/git/git.zsh
# Wrap git with hub

emulate -L zsh

# 缓存命令检查结果
typeset -gA __G_CACHE
__g_has_cmd() {
  [[ -n "${__G_CACHE[$1]}" ]] && return ${__G_CACHE[$1]}
  (( $+commands[$1] )) && __G_CACHE[$1]=0 || __G_CACHE[$1]=1
  return ${__G_CACHE[$1]}
}

# 优化的最后提交信息格式
readonly __G_COMMIT_FORMAT='%C(238)%cr%Creset %C(blue)%h%Creset %s - %C(cyan)%aN %C(238)%(describe:tags,abbrev=0)%Creset'

# 获取最后提交信息
function __g_last_commit() {
  git log --color=always -1 --pretty=format:"$__G_COMMIT_FORMAT" --date=auto:human 2>/dev/null
}

# Hack because otherwise compdef doesn't work with zinit for some reason.
# autoload -Uz compinit compdef && compinit -C -d "${ZDOTDIR}/${zcompdump_file:-.zcompdump}"

# 主函数
function g() {
  __g_has_cmd git || return 1

  local __cmd
  if __g_has_cmd hub; then
    compdef g=hub
    __cmd=$commands[hub]
  else
    compdef g=git
    __cmd=$commands[git]
  fi

  if (( $# == 0 )); then
    local __last_commit
    __last_commit=$(__g_last_commit)
    [[ -n "$__last_commit" ]] && printf '%s\n\n' "$__last_commit"
    "$__cmd" status --short --branch 2>/dev/null
  else
    "$__cmd" "$@"
  fi
}

g "$@"
