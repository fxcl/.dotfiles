# Create a git.io short URL
function gitio() {
  local GIT_IO_URL="https://git.io/"
  
  if [[ -z "$1" || -z "$2" ]]; then
    echo "Usage: gitio <slug> <url>" >&2
    echo "Example: gitio my-short https://github.com/user/repo" >&2
    return 1
  fi

  curl -i "$GIT_IO_URL" -F "url=$2" -F "code=$1"
}
