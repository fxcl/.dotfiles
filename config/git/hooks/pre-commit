#!/usr/bin/env bash
set -ue -o pipefail

# Look for files that still have conflict markers (<<<<<<<, =======, >>>>>>>)
CONFLICTS="$(git diff --cached --name-only --diff-filter=ACMRT -G'^<{7}|^={7}|^>{7}')"

if [[ -z "${GIT_DIR-}" ]]; then
	GIT_DIR="$(git rev-parse --git-dir 2>/dev/null)"
fi

if [[ -n "$CONFLICTS" ]]; then
	echo "Unresolved merge conflicts in this commit:"
	echo "$CONFLICTS"
	exit 1
else
	if [[ -f "$GIT_DIR/hooks/pre-commit" ]]; then
		exec "$GIT_DIR/hooks/pre-commit" "$@"
	fi
fi
