# Zimfw configuration optimized for performance

# Enable debug mode only when needed
# zmodule debug

# Core modules (loaded first)
zmodule input       # Correct input event bindings
zmodule termtitle   # Custom terminal title
zmodule utility     # Utility aliases and functions
zmodule git-info    # Git status for prompts

# Completion system (must be loaded in order)
zmodule zsh-users/zsh-completions  # Additional completions
zmodule completion                 # Smart tab completion
zmodule zsh-users/zsh-syntax-highlighting  # Syntax highlighting

# Performance-sensitive modules
zmodule agkozak/zsh-z --on-pwd  # Directory tracking (lazy-loaded)
zmodule zpm-zsh/clipboard --on-cmd clipboard  # Clipboard wrapper (lazy-loaded)

# Nix integration (only if directories exist)
xmodule() {
  if [ -d "$1" ]; then
    zmodule "$@" --fpath site-functions
  fi
}
xmodule /nix/var/nix/profiles/default/share/zsh --name nix
xmodule "$HOME/.nix-profile/share/zsh" --name nix-profile

# vi: set ft=zsh et ts=4
