# Skip unavailable external modules

# Modules
xmodule() {
  if [ -d "$1" ]; then
    zmodule "$@" --fpath site-functions
  fi
}

# Applies correct bindkeys for input events
zmodule input
# Sets a custom terminal title
zmodule termtitle
# Utility aliases and functions. Adds colour to ls, grep and less
zmodule utility
# Exposes git repository status information to prompts, used by asciiship
zmodule git-info

# Nix completions
xmodule /nix/var/nix/profiles/default/share/zsh --name nix
# Nix profile completions
xmodule ~/.nix-profile/share/zsh --name nix-profile

# CMake, Go, Maven, and Yarn completions
zmodule zsh-users/zsh-completions

# Enables and configures smart and extensive tab completion
# completion must be sourced after zsh-users/zsh-completions
zmodule completion

# Fish-like syntax highlighting for Zsh
# zsh-users/zsh-syntax-highlighting must be sourced after completion
zmodule zsh-users/zsh-syntax-highlighting

# Tracks most used directories by 'frecency'
zmodule agkozak/zsh-z

# Cross-platform clipboard wrapper
zmodule zpm-zsh/clipboard

# vi: set ft=zsh et ts=4
